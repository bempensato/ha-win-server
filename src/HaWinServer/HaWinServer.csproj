<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HaWinServer</AssemblyName>
    <RootNamespace>HaWinServer</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- app.manifest now also declares dpiAwareness directly - see its
         comment for why this property alone was not reaching the built exe.
         That makes the Application.SetHighDpiMode() call this property
         generates a documented no-op at runtime, which the analyzer flags
         as WFO0003 - harmless, so suppressed rather than dropping either
         declaration. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No admin required: this app installs everything under %LOCALAPPDATA% and HKCU. -->

    <!--
      Local/dev builds intentionally report "0.0.0-dev" (see AppVersion) so
      they are never mistaken for a real release and never offered a
      self-update. The release workflow overrides both properties on the
      command line with the pushed tag (e.g. -p:Version=1.3.0
      -p:InformationalVersion=1.3.0-beta.1).
    -->
    <Version>0.0.0</Version>
    <InformationalVersion>0.0.0-dev</InformationalVersion>
  </PropertyGroup>

</Project>
